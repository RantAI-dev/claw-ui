# RantaiClaw gateway base URL (server-side only — never exposed to the browser)
RANTAICLAW_GATEWAY_URL=http://127.0.0.1:3000

# Bearer token issued by `POST /pair`. Leave empty if the gateway runs with
# [gateway] require_pairing = false. scripts/dev.sh / `bun run pair` can fill this in.
RANTAICLAW_TOKEN=
