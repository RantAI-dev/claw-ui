# RantaiClaw gateway base URL (server-side only — never exposed to the browser)
RANTAICLAW_GATEWAY_URL=http://127.0.0.1:3000

# Bearer token issued by `POST /pair`. Leave empty if the gateway runs with
# [gateway] require_pairing = false. scripts/setup-minimax.mjs can fill this in.
RANTAICLAW_TOKEN=

# To reach the dev server from other devices (LAN / Tailscale), list the IPs/hosts
# you'll access it from (comma-separated) so Next's dev server allows their HMR/asset
# requests. Dev-only — production (next start) ignores this. Example:
# RANTAICLAW_UI_DEV_ORIGINS=192.168.1.50,100.107.165.77
RANTAICLAW_UI_DEV_ORIGINS=

# Set a password to require login (strongly recommended when the UI is reachable
# over the network). Unset = no auth (fine for loopback-only dev). Optionally set
# RANTAICLAW_UI_SECRET to a long random string to sign session cookies (defaults
# to the password). Changing either invalidates existing sessions.
RANTAICLAW_UI_PASSWORD=
RANTAICLAW_UI_SECRET=

# The login brute-force lockout keys per client IP only when the UI runs behind a
# trusted reverse proxy that sets X-Forwarded-For / X-Real-IP — set this to 1 in
# that case. Unset (default) = all clients share one global lockout counter, the
# safe choice for a directly-reachable server where forwarding headers are forgeable.
RANTAICLAW_UI_TRUST_PROXY=
